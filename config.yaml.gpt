# Climate LLM Benchmark Configuration File
# This file provides default configuration for the climate_llm_benchmark.py script
# Command line arguments will override these settings when provided

# Basic benchmark settings
benchmark:
  mesh_file: "meshes/mesh_data_20deg.json"  # Path to mesh data file
  num_repeats: 10                           # Number of queries per mesh point
  simple_mode: true                         # Simple mode (single month) vs full mode (all months)
  month: "July"                             # Month for simple mode (ignored in full mode)
  use_batch: true                           # Use batch processing for multiple repeats
  disable_tracing: false                    # Disable LangSmith tracing for faster processing
  resume: false                             # Resume from latest intermediate file

# Model configuration
model:
  provider: "openai"                        # openai, anthropic, google, ollama
  name: "gpt-5-nano"                        # Model name
  temperature: 0                            # Temperature for generation (0-1)
  max_tokens: 300                           # Max tokens for response (simple mode uses less)
  max_retries: 3                            # Max retries per query
  timeout: 30                               # Timeout in seconds for individual requests

# Provider-specific configurations
providers:
  openai:
    api_key_env: "OPENAI_API_KEY"          # Environment variable for API key
    base_url: null                          # Custom base URL (optional)
    organization: null                      # Organization ID (optional)
  
  anthropic:
    api_key_env: "ANTHROPIC_API_KEY"       # Environment variable for API key
    base_url: null                          # Custom base URL (optional)
  
  google:
    api_key_env: "GOOGLE_API_KEY"          # Environment variable for API key
  
  ollama:
    base_url: "http://localhost:11434"      # Ollama server URL
    timeout: 60                             # Longer timeout for local models

# Batch processing settings
batch:
  max_concurrency: 10                       # Max concurrent requests in batch mode
  save_interval: 10                        # Save intermediate results every N points

# Output settings
output:
  results_dir: "results"                    # Directory for results